+    private static Object createPlayerTypeObserver(java.util.function.Consumer<PlayerType> callback) {
+        Method addObserver = findPlayerTypeEventMethod("addObserver");
+        if (addObserver == null) return null;
+        Class<?> observerType = addObserver.getParameterTypes()[0];
+        return Proxy.newProxyInstance(observerType.getClassLoader(), new Class<?>[]{observerType},
+                (proxy, method, args) -> {
+                    switch (method.getName()) {
+                        case "equals":
+                            return proxy == args[0];
