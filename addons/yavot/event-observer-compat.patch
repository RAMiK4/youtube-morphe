+    private static Method findPlayerTypeEventMethod(String name) {
+        for (Method method : PlayerType.getOnChange().getClass().getMethods()) {
+            if (method.getName().equals(name) && method.getParameterTypes().length == 1
+                    && method.getParameterTypes()[0].isInterface()) {
+                return method;
+            }
+        }
+        return null;
+    }
