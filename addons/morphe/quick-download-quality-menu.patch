+                                                ClientType preferredClient, Choice choice,
+                                                Launcher launcher) {
+        SheetBottomDialog.DraggableLinearLayout mainLayout =
+                SheetBottomDialog.createMainLayout(context, backgroundColor);
+        mainLayout.setPadding(0, 0, 0, Dim.dp8);
+
+        Header header = createHeader();
+        mainLayout.addView(header.view);
+
+        // A long list scrolls, and the buttons under it stay on screen.
+        LinearLayout list = new LinearLayout(context);
+        list.setOrientation(LinearLayout.VERTICAL);
+        list.setPadding(0, 0, 0, Dim.dp4);
+        ScrollView scrollView = SheetBottomDialog.createCappedScrollView(context);
+        scrollView.addView(list);
+        mainLayout.addView(scrollView);
+
+        SheetBottomDialog.SlideDialog dialog =
+                SheetBottomDialog.createSlideDialog(context, mainLayout, animationDuration);
+
+        // Video qualities. The qualities below HD are shown only for videos without HD.
+        list.addView(createSectionHeader(str("morphe_external_downloader_quick_quality")));
+        for (final int height : videoHeights) {
+            final boolean h264 = height <= QuickDownloadFormats.MAX_H264_HEIGHT;
+            String codecs = h264
+                    ? Codec.H264.displayName
+                    : Codec.AV1.displayName + " / " + Codec.VP9.displayName;
+            Bundle extras = new Bundle();
+            extras.putInt("VIDEO_QUALITY", height);
+            extras.putString("VIDEO_CODEC", h264 ? "h264" : "av1");
+            Row row = createRow(height + "p", qualityBadge(height),
