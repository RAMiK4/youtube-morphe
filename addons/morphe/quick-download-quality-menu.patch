+
+        final int secondaryColor = withAlpha(ThemeUtils.getAppForegroundColor(), SECONDARY_TEXT_ALPHA);
+        for (int i = 0; i < videoRows.length; i++) {
+            QuickDownloadFormats.VideoQuality quality = formats.videos()[i];
