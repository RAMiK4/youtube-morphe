+        mainLayout.addView(createButtons(
+                backgroundColor != null ? backgroundColor : ThemeUtils.getDialogBackgroundColor(),
+                () -> {
+                    dialog.dismiss();
+                    // YTindir opens its download window itself instead of its own quick list.
