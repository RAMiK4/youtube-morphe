+    /**
+     * An icon of filled polygons, drawn in the given color.
+     * The apps have no icons of their own for every menu, so they are drawn here.
+     */
+    private static final class IconDrawable extends Drawable {
+        private static final float VIEWPORT = 24;
+
+        private final float[][] polygons;
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path path = new Path();
+
+        /**
+         * @param polygons Points of each polygon, x and y in turn, in a 24 x 24 viewport.
+         */
+        IconDrawable(float[][] polygons, int color) {
+            this.polygons = polygons;
+            paint.setColor(color);
+            paint.setStyle(Paint.Style.FILL);
+        }
+
+        @Override
+        protected void onBoundsChange(@NonNull Rect bounds) {
+            final float scale = Math.min(bounds.width(), bounds.height()) / VIEWPORT;
+            path.reset();
+            for (float[] points : polygons) {
+                path.moveTo(bounds.left + points[0] * scale, bounds.top + points[1] * scale);
+                for (int i = 2; i < points.length; i += 2) {
+                    path.lineTo(bounds.left + points[i] * scale, bounds.top + points[i + 1] * scale);
+                }
+                path.close();
+            }
+        }
+
+        @Override
+        public void draw(@NonNull Canvas canvas) {
+            canvas.drawPath(path, paint);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            paint.setAlpha(alpha);
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter colorFilter) {
+            paint.setColorFilter(colorFilter);
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+}
