+        Option mp3 = mp3Option = addAudioOption(list, "mp3", "MP3",
+                ExternalDownloaderPreference.QUICK_DOWNLOAD_AUDIO_KBPS + " kbps",
+                "Opus → MP3" + DETAIL_SEPARATOR + str("morphe_external_downloader_quick_recommended"));
