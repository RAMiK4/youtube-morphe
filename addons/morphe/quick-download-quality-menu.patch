+    private void mark(Option option, boolean byUser) {
+        if (marked != null) setMarked(marked.row, false);
+        marked = option;
+        markedByUser |= byUser;
+        setMarked(option.row, true);
+    }
+
+    private void setMarked(Row row, boolean isMarked) {
+        row.check.setVisibility(isMarked ? View.VISIBLE : View.GONE);
+        row.view.setSelected(isMarked);
+        row.view.setBackground(createRowBackground(isMarked));
+    }
