+    private void showFormats(@Nullable QuickDownloadFormats.Formats formats, Header header, Row m4aRow, Row mp3Row) {
+        if (formats == null) {
+            // Sizes unknown, every HD choice stays.
+            for (Option option : videoOptions) option.row.size.setText("");
+            m4aRow.size.setText("");
+            mp3Row.size.setText("");
+            return;
+        }
+
+        if (!TextUtils.isEmpty(formats.title())) {
+            header.title.setText(formats.title());
+        }
+        List<String> details = new ArrayList<>();
+        if (!TextUtils.isEmpty(formats.author())) details.add(formats.author());
+        if (formats.lengthSeconds() > 0) details.add(MediaTime.format(formats.lengthSeconds() * 1000));
+        if (!details.isEmpty()) {
+            header.subtitle.setText(TextUtils.join(DETAIL_SEPARATOR, details));
+            header.subtitle.setVisibility(View.VISIBLE);
+        }
+
+        // 480p only for videos without HD, and the qualities below it only for videos without 480p either.
+        int bestHeight = 0;
+        for (int i = 0; i < videoHeights.length; i++) {
+            if (formats.videos()[i] != null) bestHeight = Math.max(bestHeight, videoHeights[i]);
+        }
+        final int minHeight = bestHeight >= MIN_HD_HEIGHT ? MIN_HD_HEIGHT
+                : bestHeight >= MIN_SD_HEIGHT ? MIN_SD_HEIGHT : 0;
+
+        Option recommended = null;
+        int recommendedHeight = 0;
+        for (int i = 0; i < videoHeights.length; i++) {
+            QuickDownloadFormats.VideoQuality quality = formats.videos()[i];
+            Option option = videoOptions.get(i);
+            Row row = option.row;
+            final int height = videoHeights[i];
+            if (quality == null || height < minHeight) {
+                row.view.setVisibility(View.GONE);
+                continue;
+            }
+            row.view.setVisibility(View.VISIBLE);
+            row.title.setText(qualityTitle(height, quality.fps()));
+            row.detail.setText(quality.codec().displayName + DETAIL_SEPARATOR + str(qualityHint(height)));
+            row.size.setText(formatSize(quality.bytes()));
+            // Full HD, else the best quality below it, else the lowest above it.
+            if (recommended == null || recommendedHeight > QuickDownloadFormats.MAX_H264_HEIGHT) {
+                recommended = option;
+                recommendedHeight = height;
+            }
+        }
+
+        // Read from the stream: the real bitrate, without the approximate sign.
+        if (formats.aacKbps() > 0) m4aRow.badge.setText(formats.aacKbps() + " kbps");
+        m4aRow.size.setText(formatSize(formats.aacBytes()));
+        // A constant bitrate MP3 of the stream's length.
+        mp3Row.size.setText(formatSize(formats.mp3Bytes()));
+
+        // A quality the video does not have, or the default quality, moves to the one closest to Full HD,
+        // or to the MP3 if the video has none of the qualities.
+        final boolean markedIsHidden = marked != null && marked.row.view.getVisibility() != View.VISIBLE;
+        if (markedIsHidden || (!markedByUser && videoOptions.contains(marked))) {
+            mark(recommended != null ? recommended : Objects.requireNonNull(mp3Option), false);
+        }
+    }
